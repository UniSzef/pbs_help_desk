SERVER_PORT=8080

# Supabase PostgreSQL connection string (Session Pooler port 5432, Transaction Pooler 6543, or Direct DB)
# Supabase Dashboard -> Connect -> URI
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Minimum 16 random characters
JWT_SECRET=replace-this-with-a-strong-random-secret-key
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated frontend origins allowed for CORS with HttpOnly cookies
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173
COOKIE_DOMAIN=
